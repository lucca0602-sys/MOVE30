{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build-config.mjs",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/teste.html" },
    { "source": "/dash/:token", "destination": "/dash.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
