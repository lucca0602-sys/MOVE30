DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
N8N_WEBHOOK_URL=
ESP32_API_KEY=
API_URL=http://127.0.0.1:8002
DASHBOARD_PUBLIC_URL=
# Front da Vercel: base do link /dash/<token> que o Streamlit reemite em QR
FRONT_PUBLIC_URL=https://SEU-PROJETO.vercel.app
# Opcionais
BACKUP_DIR=
WORKER_INTERVALO_S=60
IA_TIMEOUT_S=180
IA_INTERVALO_S=600
# Hospedagem (Vercel + Tailscale Funnel)
# Origens que podem chamar a API (separadas por vírgula). Coloque a URL da Vercel, sem barra no fim.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://SEU-PROJETO.vercel.app
# Opcional: aceita previews da Vercel do seu projeto
CORS_ORIGIN_REGEX=^https://SEU-PROJETO(-[a-z0-9-]+)?\.vercel\.app$
